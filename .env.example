# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/life_manager?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=generate-a-long-random-string-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Used to encrypt/decrypt vault password entries at rest (32 bytes min)
VAULT_ENCRYPTION_KEY=generate-a-long-random-string-at-least-32-chars

# Seed user (optional, for local development)
SEED_EMAIL=demo@example.com
SEED_PASSWORD=password123
SEED_NAME=Demo User
SEED_MASTER_PASSWORD=1234
